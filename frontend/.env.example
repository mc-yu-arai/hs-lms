# バックエンドAPIのベースURL（backend/.env の API_BASE_URL と合わせる）
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
# セッションタイムアウト（分）。backend/.env の SESSION_TIMEOUT_MINUTES と合わせる
NEXT_PUBLIC_SESSION_TIMEOUT_MINUTES=30
# SupabaseプロジェクトURL（backend/.env の SUPABASE_URL と同じ値。SCORM/LearnWizコンテンツの
# 同一オリジン配信プロキシ app/api/lesson-content/[...path] が公開Storage URLの組み立てに使用。
# 秘密鍵ではなくプロジェクトURL自体は非機密情報）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
