# ============================================================
# HS-LMS 環境変数テンプレート
# ============================================================
# このファイルをコピーして ".env" にリネームし、
# 各自の値を設定してください。
# .env は絶対にGitにコミットしないこと（.gitignoreに追加済みであることを確認）
# ============================================================

# ------------------------------------------------------------
# Supabase
# ------------------------------------------------------------
# Supabaseダッシュボード → Settings → API から取得
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...   # Publishable key（旧: anon public key）
SUPABASE_SECRET_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...        # Secret key（旧: service_role key）※バックエンドのみで使用。絶対に公開しない

# ------------------------------------------------------------
# JWT（アクセストークン生成用）
# ------------------------------------------------------------
# 任意の長いランダム文字列を設定（32文字以上推奨）
# 生成例: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=ここにランダムな文字列を設定
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# ------------------------------------------------------------
# Google OAuth 2.0
# ------------------------------------------------------------
# Google Cloud Console → APIとサービス → 認証情報 → 作成したOAuthクライアント から取得
GOOGLE_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxx

# ------------------------------------------------------------
# Resend（メール送信）
# ------------------------------------------------------------
# Resendダッシュボード → API Keys から取得
RESEND_API_KEY=re_xxxxxxxxxx
# 開発段階はテスト用ドメインを使用。本番移行時に自社ドメインに変更する
RESEND_FROM_EMAIL=onboarding@resend.dev

# ------------------------------------------------------------
# アプリケーション設定
# ------------------------------------------------------------
# バックエンドAPIのベースURL
API_BASE_URL=http://localhost:3001
# フロントエンドのURL（OAuthのリダイレクト先などに使用）
FRONTEND_URL=http://localhost:3000
# 実行環境（development / production）
NODE_ENV=development

# ------------------------------------------------------------
# セキュリティ設定
# ------------------------------------------------------------
# ログイン試行制限（仕様書通り: 5回失敗で15分ロック）
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# セッションタイムアウト（仕様書通り: 非操作30分）
SESSION_TIMEOUT_MINUTES=30
# パスワードリセットトークン有効期限（仕様書通り: 1時間）
PASSWORD_RESET_EXPIRES_MINUTES=60

# ------------------------------------------------------------
# 初期パスワード（任意）
# ------------------------------------------------------------
# 設定すると、ユーザー手動作成・CSVインポートの初期パスワードが
# ランダム生成の代わりにこの固定値になる（全テスターが同じパスワードで
# ログインできるようにする検証用途）。未設定ならこれまで通りランダム生成。
# 8文字以上・英数字記号混在のパスワードポリシーを満たす値を設定すること
# DEFAULT_USER_PASSWORD=TestPass1!
